# Default: normalize text to LF in the repo (Linux server / Docker).
* text=auto eol=lf

# Explicit source / config
*.py      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.example text eol=lf
*.json    text eol=lf
.env*     text eol=lf

# Keep Git metadata consistent
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.dat  binary
*.so   binary
*.dll  binary
*.exe  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.bz2  binary
